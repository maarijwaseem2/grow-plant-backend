# ---- Auth ----
JWT_KEY=change-me-to-a-long-random-string
JWT_EXPIRES=1d

# ---- Database (local dev) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=gogreen
# Set to true for Neon / managed Postgres (needs SSL). Leave blank/false locally.
DB_SSL=

# ---- Admin seed ----
ADMIN_EMAIL=admin@gogreen.pk
ADMIN_PASSWORD=change-me-strong-password

# ---- Server ----
PORT=3001
# Comma-separated allowed origins (your Vercel URL in production)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# ---- AI microservice (FastAPI) ----
AI_SERVICE_URL=http://localhost:8000

# ---- Chatbot (OpenAI) — optional. Stripe is NOT used anymore. ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Redis (OPTIONAL) — leave blank to run without it. For Upstash set all three. ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=
