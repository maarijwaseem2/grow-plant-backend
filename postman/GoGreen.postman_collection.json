{
  "info": {
    "name": "Go Green \u2014 API",
    "description": "Full API collection for the Go Green platform (NestJS backend + FastAPI AI service).\n\nSet {{base_url}} (default http://localhost:3001). Log in first, then copy the returned token into {{token}} / {{admin_token}} / {{gardener_token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "ai_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "gardener_token",
      "value": ""
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Returns { data: { id, username, email, role, token } }. Copy token into a variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gogreen.pk\",\n  \"password\": \"Admin@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Admin dashboard (Admin only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "dashboard"
              ]
            }
          }
        }
      ]
    },
