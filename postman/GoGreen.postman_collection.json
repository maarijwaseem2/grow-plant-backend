    {
      "name": "AI (spot finder + verify)",
      "item": [
        {
          "name": "Suggest public spots (via gateway)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ai/suggest-spots?lat=24.8607&lng=67.0011&radius=5000&limit=30",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ai",
                "suggest-spots"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "24.8607"
                },
                {
                  "key": "lng",
                  "value": "67.0011"
                },
                {
                  "key": "radius",
                  "value": "5000"
                },
                {
                  "key": "limit",
                  "value": "30"
                }
              ]
            },
            "description": "Returns GeoJSON of suggested PUBLIC plantable spots and caches them to PostGIS."
          }
        },
        {
          "name": "Verify plant photo (via gateway)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ai/verify-plant",
